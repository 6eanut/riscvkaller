#
# requires: arch=riscv64 -threaded
#

# Covers:
#   kvm_sbi_ext_pmu_handler, kvm_riscv_vcpu_pmu_num_ctrs,
#   kvm_riscv_vcpu_pmu_ctr_info, kvm_pmu_get_perf_event_type,
#   kvm_pmu_get_fixed_pmc_index, kvm_pmu_get_programmable_pmc_index,
#   kvm_riscv_vcpu_pmu_ctr_cfg_match, kvm_pmu_validate_counter_mask,
#   kvm_pmu_create_perf_event, kvm_pmu_get_{config,hw_config,sample_period},
#   kvm_riscv_vcpu_pmu_snapshot_set_shmem,
#   kvm_riscv_vcpu_pmu_ctr_start, kvm_riscv_vcpu_pmu_ctr_stop,
#   kvm_pmu_release_perf_event, kvm_riscv_vcpu_pmu_fw_ctr_read,
#   kvm_riscv_vcpu_csr_return.
#
r0 = openat$kvm(0, &AUTO='/dev/kvm\x00', 0x0, 0x0)
r1 = ioctl$KVM_CREATE_VM(r0, AUTO, 0x0)
r2 = syz_kvm_setup_syzos_vm$riscv64(r1, &(0x7f0000c00000/0x400000)=nil)

# Payload design:
#
#  1. PMU_NUM_COUNTERS (FID=0)      → kvm_riscv_vcpu_pmu_num_ctrs
#  2. PMU_CTR_GET_INFO idx=0 (FID=1)→ kvm_riscv_vcpu_pmu_ctr_info
#                                     + kvm_pmu_get_fixed_pmc_index (cycle, fixed)
#  3. PMU_CTR_GET_INFO idx=3 (FID=1)→ kvm_pmu_get_programmable_pmc_index (index≥3)
#  4. PMU_SNAPSHOT_SET_SHMEM (FID=6)→ kvm_riscv_vcpu_pmu_snapshot_set_shmem
#     gpa_lo=-1, gpa_hi=-1 = disable (safe, no valid GPA needed)
#  5. PMU_CTR_CFG_MATCH (FID=2)     → kvm_riscv_vcpu_pmu_ctr_cfg_match
#     cbase=3, cmask=1: force assignment to counter index 3
#     event=1 (SBI_PMU_HW_CPU_CYCLES)
#     → kvm_pmu_validate_counter_mask, kvm_pmu_create_perf_event,
#       kvm_pmu_get_{perf_event_type,config,hw_config,programmable_pmc_index}
#  6. PMU_CTR_START (FID=3)         → kvm_riscv_vcpu_pmu_ctr_start
#     ctr_base=3, ctr_mask=1, flags=0
#     → kvm_pmu_get_sample_period
#  7. PMU_CTR_STOP (FID=4)          → kvm_riscv_vcpu_pmu_ctr_stop
#     ctr_base=3, ctr_mask=1, flags=0
#  8. PMU_CTR_FW_READ idx=0 (FID=5) → kvm_riscv_vcpu_pmu_fw_ctr_read
#     (idx=0 may be HW, function still called; add idx=29 for FW counter)
#  9. PMU_CTR_STOP reset (FID=4)    → kvm_pmu_release_perf_event
#     flags=1 (SBI_PMU_STOP_FLAG_RESET)
# 10. csrr hpmcounter3 (CSR 0xc03)  → kvm_riscv_vcpu_csr_return
#     Must come LAST: counter 3 was configured above, KVM emulates the read.
#     If KVM still injects an exception, guest_unexp_trap fires, but all
#     prior calls (1-9) have already been executed.
#
r3 = syz_kvm_add_vcpu$riscv64(r2, &AUTO={0x0, &AUTO=[@sbi_pmu_num_ctrs={AUTO, AUTO, 0x0},@sbi_pmu_ctr_info={AUTO, AUTO, {0x0}},@sbi_pmu_ctr_info={AUTO, AUTO, {0x3}},@sbi_pmu_snapshot_set_shmem={AUTO, AUTO, {0xffffffffffffffff, 0xffffffffffffffff, 0x0}},@sbi_pmu_ctr_cfg_match={AUTO, AUTO, {0x3, 0x1, 0x0, 0x1}},@sbi_pmu_ctr_start={AUTO, AUTO, {0x3, 0x1, 0x0, 0x0}},@sbi_pmu_ctr_stop={AUTO, AUTO, {0x3, 0x1, 0x0}},@sbi_pmu_fw_ctr_read={AUTO, AUTO, {0x0}},@sbi_pmu_fw_ctr_read={AUTO, AUTO, {0x1d}},@sbi_pmu_ctr_stop={AUTO, AUTO, {0x3, 0x1, 0x1}},@csrr={AUTO, AUTO, {@valid=0xc03}}], AUTO}, 0x0, 0x0)

r4 = ioctl$KVM_GET_VCPU_MMAP_SIZE(r0, AUTO)
r5 = mmap$KVM_VCPU(&(0x7f0000009000/0x1000)=nil, r4, 0x3, 0x1, r3, 0x0)

ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$riscv64(r3, r5, 0xffffffffffffffff)