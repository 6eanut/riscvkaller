#
# requires: arch=riscv64 -threaded
#

# Covers per-extension SBI APIs:
#   - BASE:   GET_SPEC_VERSION, GET_IMP_ID, GET_IMP_VERSION, PROBE_EXT
#   - TIME:   SET_TIMER (stime=0)
#   - IPI:    SEND_IPI  (empty mask, safe)
#   - RFENCE: REMOTE_FENCE_I, REMOTE_SFENCE_VMA
#   - HSM:    HART_STATUS for hart 0
#   - NACL:   PROBE_FEATURE for SYNC_CSR
#   - FWFT:   GET for MISALIGNED_EXC_DELEG
#   - DBCN:   CONSOLE_WRITE_BYTE (byte=0x41 'A')
#   - DBTR:   NUM_TRIGGERS query
#
r0 = openat$kvm(0, &AUTO='/dev/kvm\x00', 0x0, 0x0)
r1 = ioctl$KVM_CREATE_VM(r0, AUTO, 0x0)
r2 = syz_kvm_setup_syzos_vm$riscv64(r1, &(0x7f0000c00000/0x400000)=nil)

r3 = syz_kvm_add_vcpu$riscv64(r2,&AUTO={0x0, &AUTO=[@sbi_base={AUTO, AUTO, {0x3, 0x54494D45}},@sbi_base={AUTO, AUTO, {0x0, 0x0}},@sbi_base={AUTO, AUTO, {0x1, 0x0}},@sbi_time={AUTO, AUTO, {0x0}},@sbi_ipi={AUTO, AUTO, {0x0, 0x0}},@sbi_rfence={AUTO, AUTO, {0x0, 0x0, 0x0, 0x0, 0x0, 0x0}},@sbi_rfence={AUTO, AUTO, {0x1, 0x0, 0x0, 0x0, 0x0, 0x0}},@sbi_hsm={AUTO, AUTO, {0x2, 0x0, 0x0, 0x0}},@sbi_nacl={AUTO, AUTO, {0x0, 0x0, 0x0}},@sbi_fwft={AUTO, AUTO, {0x1, 0x0, 0x0, 0x0}},@sbi_dbcn={AUTO, AUTO, {0x2, 0x41, 0x0, 0x0}},@sbi_dbtr={AUTO, AUTO, {0x0, 0x0, 0x0, 0x0}},@uexit={AUTO, AUTO, 0x0}], AUTO},0x0, 0x0)

r4 = ioctl$KVM_GET_VCPU_MMAP_SIZE(r0, AUTO)
r5 = mmap$KVM_VCPU(&(0x7f0000009000/0x1000)=nil, r4, 0x3, 0x1, r3, 0x0)

ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$riscv64(r3, r5, 0x0)