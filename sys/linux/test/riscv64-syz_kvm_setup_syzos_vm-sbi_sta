#
# requires: arch=riscv64 -threaded
#

# Covers:
#   kvm_sbi_ext_sta_handler, kvm_sbi_sta_steal_time_set_shmem.
#
# SBI STA (Steal Time Accounting) extension ID = 0x535441.
# FID=0: SBI_EXT_STA_STEAL_TIME_SET_SHMEM
#   - gpa_lo=-1, gpa_hi=-1 → disable (clear the shared memory mapping)
#   - gpa_lo=0,  gpa_hi=0  → enable with GPA=0 (may fail, still calls the function)
#
r0 = openat$kvm(0, &AUTO='/dev/kvm\x00', 0x0, 0x0)
r1 = ioctl$KVM_CREATE_VM(r0, AUTO, 0x0)
r2 = syz_kvm_setup_syzos_vm$riscv64(r1, &(0x7f0000c00000/0x400000)=nil)

r3 = syz_kvm_add_vcpu$riscv64(r2, &AUTO={0x0, &AUTO=[@sbi_sta_set_shmem={AUTO, AUTO, {0xffffffffffffffff, 0xffffffffffffffff, 0x0}},@sbi_sta_set_shmem={AUTO, AUTO, {0x0, 0x0, 0x0}}], AUTO}, 0x0, 0x0)

r4 = ioctl$KVM_GET_VCPU_MMAP_SIZE(r0, AUTO)
r5 = mmap$KVM_VCPU(&(0x7f0000009000/0x1000)=nil, r4, 0x3, 0x1, r3, 0x0)

ioctl$KVM_RUN(r3, AUTO, 0x0)
syz_kvm_assert_syzos_uexit$riscv64(r3, r5, 0xffffffffffffffff)